{
  "inputs": [
    {
      "id": "stitchKey",
      "type": "promptString",
      "description": "Stitch API key",
      "password": true
    }
  ],
  "servers": {
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:stitchKey}"
      }
    }
  }
}
