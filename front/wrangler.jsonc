{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rm-tours-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "services": [{ "binding": "API", "service": "rm-tours-api" }],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
